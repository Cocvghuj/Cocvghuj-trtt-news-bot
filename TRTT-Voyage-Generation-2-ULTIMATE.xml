<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:templateVersion='2.0.0' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <b:include data='blog' name='all-head-content'/>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <meta content='#11152D' name='theme-color'/>
  <title><data:view.title.escaped/></title>
  <b:skin><![CDATA[
:root{--trtt-pink:#E98BAF;--trtt-piyaji:#B77991;--trtt-gold:#D6A542;--trtt-midnight:#11152D;--trtt-white:#FFFFFF;--trtt-cyan:#67E8F9;--trtt-diamond:#FFD700;--trtt-width:1180px}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--trtt-white);color:var(--trtt-midnight);font:16px/1.65 system-ui,-apple-system,"Segoe UI",sans-serif}
a{color:var(--trtt-piyaji);text-decoration:none}
a:hover,a:focus{color:var(--trtt-midnight);text-decoration:underline}
img{max-width:100%;height:auto}
#trtt-shell{max-width:var(--trtt-width);margin:auto;padding:0 20px}
#trtt-top{background:var(--trtt-midnight);color:var(--trtt-white);border-bottom:3px solid var(--trtt-gold)}
#trtt-brand{padding:28px 0 22px}
#trtt-brand h1,#trtt-brand .title{margin:0;color:var(--trtt-white);font:700 clamp(28px,5vw,48px)/1.12 Georgia,serif}
#trtt-brand .description{margin:10px 0 0;color:var(--trtt-pink);font-size:14px;letter-spacing:.04em}
#trtt-menu{background:var(--trtt-midnight);border-top:1px solid rgba(255,255,255,.16)}
#trtt-menu ul{display:flex;flex-wrap:wrap;gap:8px 22px;list-style:none;margin:0;padding:13px 0}
#trtt-menu a{color:var(--trtt-white);font-weight:700}
#trtt-menu a:hover{color:var(--trtt-diamond)}
#trtt-hero{margin:26px auto 30px;padding:clamp(24px,5vw,48px);background:var(--trtt-midnight);border:1px solid var(--trtt-gold);border-radius:18px;color:var(--trtt-white)}
#trtt-hero .kicker{color:var(--trtt-gold);font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}
#trtt-hero h2{max-width:900px;margin:10px 0;color:var(--trtt-white);font:700 clamp(30px,5vw,58px)/1.08 Georgia,serif}
#trtt-hero p{max-width:760px;margin:12px 0 0;color:var(--trtt-pink);font-weight:600}
#trtt-main-grid{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:30px;align-items:start}
#main-wrapper,#sidebar-wrapper{min-width:0}
.widget{margin:0 0 24px}
.widget-title,.widget h2{font-size:18px;color:var(--trtt-piyaji)}
.post-outer,.post,.post-card{padding:22px;margin:0 0 22px;background:var(--trtt-white);border:1px solid rgba(183,121,145,.38);border-top:3px solid var(--trtt-pink);border-radius:14px;box-shadow:0 8px 26px rgba(17,21,45,.06)}
.post-title,.post-title a{color:var(--trtt-midnight);font:700 clamp(23px,3vw,34px)/1.2 Georgia,serif}
.post-body{overflow-wrap:anywhere}
.post-body img{border-radius:12px}
.post-labels a,.label-size a{display:inline-block;margin:3px;padding:4px 9px;background:var(--trtt-pink);border-radius:999px;color:var(--trtt-midnight);font-size:12px;font-weight:700}
#sidebar-wrapper{padding-top:6px}
#footer-wrapper{margin-top:45px;background:var(--trtt-midnight);color:var(--trtt-white);border-top:3px solid var(--trtt-gold)}
#footer-wrapper a{color:var(--trtt-pink)}
#footer-wrapper .widget-title,#footer-wrapper h2{color:var(--trtt-gold)}
#trtt-footer-links{display:flex;flex-wrap:wrap;gap:12px 22px;padding:20px 0 28px;border-top:1px solid rgba(255,255,255,.18)}
#trtt-footer-links a{font-weight:700}
#trtt-footer-motto{padding:18px 0;color:var(--trtt-pink);font-size:13px}
#PageList1,#Profile1,#ReportAbuse1{display:block}
#thinking-room-separate{display:none}
@media(max-width:820px){#trtt-main-grid{grid-template-columns:1fr}#sidebar-wrapper{border-top:1px solid rgba(183,121,145,.3);padding-top:22px}}
@media(max-width:560px){#trtt-shell{padding:0 14px}#trtt-menu ul{gap:10px 16px}#trtt-hero{margin:18px auto 22px;padding:24px 18px}.post-outer,.post,.post-card{padding:17px}}
  ]]></b:skin>
</head>
<body>
  <div id='trtt-top'>
    <div id='trtt-shell'>
      <b:section id='header' class='header' maxwidgets='1' showaddelement='no'>
        <b:widget id='Header1' type='Header' title='TRTT Voyage' locked='true' version='2' visible='true'>
          <b:includable id='main'>
            <div id='trtt-brand'>
              <b:if cond='data:useImage'><a expr:href='data:blog.homepageUrl'><img expr:alt='data:title' expr:src='data:sourceUrl'/></a><b:else/><h1><a expr:href='data:blog.homepageUrl'><data:title/></a></h1></b:if>
              <b:if cond='data:description'><p class='description'><data:description/></p></b:if>
            </div>
          </b:includable>
        </b:widget>
      </b:section>
    </div>
    <div id='trtt-menu'><div id='trtt-shell'>
      <b:section id='navigation' class='navigation' maxwidgets='1' showaddelement='no'>
        <b:widget id='LinkList74' type='LinkList' title='Main Navigation' locked='true' version='2' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='sorting'>NONE</b:widget-setting>
            <b:widget-setting name='text-0'>Home</b:widget-setting><b:widget-setting name='link-0'>/</b:widget-setting>
            <b:widget-setting name='text-1'>News</b:widget-setting><b:widget-setting name='link-1'>/search/label/News</b:widget-setting>
            <b:widget-setting name='text-2'>Travel</b:widget-setting><b:widget-setting name='link-2'>/search/label/Travel</b:widget-setting>
            <b:widget-setting name='text-3'>AI</b:widget-setting><b:widget-setting name='link-3'>/search/label/AI</b:widget-setting>
            <b:widget-setting name='text-4'>Tools</b:widget-setting><b:widget-setting name='link-4'>https://cocvghuj-trtt-news-bot.vercel.app/super-app</b:widget-setting>
            <b:widget-setting name='text-5'>About</b:widget-setting><b:widget-setting name='link-5'>/p/about-us.html</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'><ul><b:loop values='data:links' var='link'><li><a expr:href='data:link.target'><data:link.name/></a></li></b:loop></ul></b:includable>
        </b:widget>
      </b:section>
    </div></div>
  </div>
  <div id='trtt-shell'>
    <b:if cond='data:view.isHomepage'>
      <section id='trtt-hero'>
        <div class='kicker'>TRTT Voyage</div>
        <h2>From Vision to Global Brand!</h2>
        <p>Explore Beyond. Discover Everything. ONE TEAM. ONE VISION. ONE JOURNEY.</p>
      </section>
    </b:if>
    <div id='trtt-main-grid'>
      <main id='main-wrapper'>
        <b:section id='main' class='main' maxwidgets='1' showaddelement='no'>
          <b:widget id='Blog1' type='Blog' title='Posts' locked='true' version='2' visible='true'>
            <b:widget-settings>
              <b:widget-setting name='showAuthor'>true</b:widget-setting>
              <b:widget-setting name='showTimestamp'>true</b:widget-setting>
              <b:widget-setting name='showLabels'>true</b:widget-setting>
              <b:widget-setting name='showCommentLink'>true</b:widget-setting>
              <b:widget-setting name='showShareButtons'>false</b:widget-setting>
              <b:widget-setting name='showDateHeader'>false</b:widget-setting>
              <b:widget-setting name='postsPerAd'>1</b:widget-setting>
            </b:widget-settings>
            <b:includable id='main'><b:loop values='data:posts' var='post'><article class='post-outer'><h2 class='post-title'><a expr:href='data:post.url'><data:post.title/></a></h2><div class='post-body'><data:post.body/></div><div class='post-labels'><b:loop values='data:post.labels' var='label'><a expr:href='data:label.url'><data:label.name/></a></b:loop></div></article></b:loop></b:includable>
          </b:widget>
        </b:section>
      </main>
      <aside id='sidebar-wrapper'>
        <b:section id='sidebar' class='sidebar' maxwidgets='20' showaddelement='yes'>
          <b:widget id='PopularPosts1' type='PopularPosts' title='Popular Posts' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:loop values='data:posts' var='post'><p><a expr:href='data:post.href'><data:post.title/></a></p></b:loop></div></b:includable></b:widget>
          <b:widget id='PopularPosts2' type='PopularPosts' title='Travel Highlights' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:loop values='data:posts' var='post'><p><a expr:href='data:post.href'><data:post.title/></a></p></b:loop></div></b:includable></b:widget>
          <b:widget id='PopularPosts3' type='PopularPosts' title='More to Explore' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:loop values='data:posts' var='post'><p><a expr:href='data:post.href'><data:post.title/></a></p></b:loop></div></b:includable></b:widget>
          <b:widget id='Label1' type='Label' title='Topics' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:loop values='data:labels' var='label'><a expr:href='data:label.url'><data:label.name/></a></b:loop></div></b:includable></b:widget>
          <b:widget id='Label3' type='Label' title='Categories' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:loop values='data:labels' var='label'><a expr:href='data:label.url'><data:label.name/></a></b:loop></div></b:includable></b:widget>
          <b:widget id='PageList1' type='PageList' title='Pages' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:loop values='data:links' var='link'><p><a expr:href='data:link.href'><data:link.title/></a></p></b:loop></div></b:includable></b:widget>
          <b:widget id='Profile1' type='Profile' title='About the Publisher' version='2' visible='true'><b:includable id='main'><div class='widget-content'><data:aboutme/></div></b:includable></b:widget>
          <b:widget id='ContactForm1' type='ContactForm' title='Contact TRTT Voyage' version='2' visible='true'><b:includable id='main'><div class='widget-content'><b:include name='widget-title'/><data:contactForm/></div></b:includable></b:widget>
          <b:widget id='ReportAbuse1' type='ReportAbuse' title='Report Abuse' version='2' visible='true'><b:includable id='main'><div class='widget-content'><a expr:href='data:reportAbuseUrl'>Report abuse</a></div></b:includable></b:widget>
          <b:widget id='LinkList70' type='LinkList' title='Brand Utilities' version='2' visible='false'><b:includable id='main'><div class='widget-content'><b:loop values='data:links' var='link'><a expr:href='data:link.target'><data:link.name/></a></b:loop></div></b:includable></b:widget>
          <b:widget id='LinkList71' type='LinkList' title='Display Settings' version='2' visible='false'><b:includable id='main'><div class='widget-content'/></b:includable></b:widget>
          <b:widget id='LinkList75' type='LinkList' title='Public Social Links' version='2' visible='true'><b:widget-settings>
            <b:widget-setting name='text-0'>WhatsApp Channel</b:widget-setting><b:widget-setting name='link-0'>https://whatsapp.com/channel/0029Vb8co9VDeONEz0B5e51M</b:widget-setting>
            <b:widget-setting name='text-1'>Telegram Channel</b:widget-setting><b:widget-setting name='link-1'>https://t.me/trttnews24bd</b:widget-setting>
            <b:widget-setting name='text-2'>Facebook</b:widget-setting><b:widget-setting name='link-2'>https://www.facebook.com/profile.php?id=61595319351601</b:widget-setting>
            <b:widget-setting name='text-3'>Support TRTT</b:widget-setting><b:widget-setting name='link-3'>https://buymeacoffee.com/engrtaher20</b:widget-setting>
          </b:widget-settings><b:includable id='main'><div class='widget-content'><b:loop values='data:links' var='link'><p><a expr:href='data:link.target'><data:link.name/></a></p></b:loop></div></b:includable></b:widget>
          <b:widget id='HTML1' type='HTML' title='TRTT Voyage Introduction' version='2' visible='true'><b:widget-settings><b:widget-setting name='content'><![CDATA[<p>TRTT Voyage — From Vision to Global Brand! Explore Beyond. Discover Everything.</p>]]></b:widget-setting></b:widget-settings><b:includable id='main'><div class='widget-content'><data:content/></div></b:includable></b:widget>
          <b:widget id='HTML6' type='HTML' title='Optional Publisher Notice' version='2' visible='false'><b:includable id='main'><div class='widget-content'/></b:includable></b:widget>
          <b:widget id='Image150' type='Image' title='TRTT Voyage Brand' version='2' visible='false'><b:includable id='main'><div class='widget-content'><data:title/></div></b:includable></b:widget>
          <b:widget id='LinkList78' type='LinkList' title='Footer Brand Links' version='2' visible='false'><b:includable id='main'><div class='widget-content'/></b:includable></b:widget>
          <b:widget id='LinkList76' type='LinkList' title='Footer Navigation' version='2' visible='false'><b:includable id='main'><div class='widget-content'/></b:includable></b:widget>
        </b:section>
      </aside>
    </div>
  </div>
  <footer id='footer-wrapper'><div id='trtt-shell'>
    <div id='trtt-footer-motto'>TRTT Voyage — From Vision to Global Brand! Explore Beyond. Discover Everything. ONE TEAM. ONE VISION. ONE JOURNEY.</div>
    <div id='trtt-footer-links'>
      <a href='https://www.trttvoyage.com/'>Official Website</a>
      <a href='https://whatsapp.com/channel/0029Vb8co9VDeONEz0B5e51M'>WhatsApp Channel</a>
      <a href='https://t.me/trttnews24bd'>Telegram Channel</a>
      <a href='https://www.facebook.com/profile.php?id=61595319351601'>Facebook</a>
      <a href='https://buymeacoffee.com/engrtaher20'>Buy Me a Coffee</a>
    </div>
  </div></footer>
</body>
</html>