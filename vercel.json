{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/trtt-loader.js", "destination": "/trtt-loader.js" },
    { "source": "/roksana-vault.js", "destination": "/roksana-vault.js" }
  ],
  "headers": [
    { "source": "/(.*).js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ]
}
