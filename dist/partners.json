import os
import json
from datetime import datetime

# GitHub Secrets থেকে মান পড়া
SITE_NAME = os.getenv("PARTNER_SITE_NAME", "FlightScoutPro")
SITE_URL = os.getenv("PARTNER_SITE_URL", "https://flightscoutpro.blogspot.com")
PARTNER_EMAIL = os.getenv("PARTNER_EMAIL", "muntasirrahaman694@gmail.com")

PARTNERS_FILE = "partners.json"

def sync_partner_network():
    print(f"[{datetime.now()}] Initializing Isolated Partner Sync Engine...")
    
    partners = []
    if os.path.exists(PARTNERS_FILE):
        try:
            with open(PARTNERS_FILE, 'r', encoding='utf-8') as f:
                partners = json.load(f)
        except json.JSONDecodeError:
            partners = []

    # নতুন পার্টনার এনট্রি তৈরি
    partner_entry = {
        "site_name": SITE_NAME,
        "site_url": SITE_URL,
        "email": PARTNER_EMAIL,
        "network": "TRTT NEWS 24 BD Partner Network",
        "last_synced": str(datetime.now())
    }

    # সাইটটি লিস্টে আগে না থাকলে যুক্ত করা
    if not any(p.get('site_url') == SITE_URL for p in partners):
        partners.append(partner_entry)
        with open(PARTNERS_FILE, 'w', encoding='utf-8') as f:
            json.dump(partners, f, indent=4, ensure_ascii=False)
        print(f"✅ Success: Added {SITE_NAME} to {PARTNERS_FILE} using GitHub Secrets!")
    else:
        print(f"ℹ️ Status: {SITE_NAME} is already synced and active in the network.")

if __name__ == "__main__":
    sync_partner_network()
